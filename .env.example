# Keep real credentials in a local .env file or terminal environment, never Git.
# The framework launcher loads this file; process environment variables take precedence.
LLM_PROVIDER=openai
LLM_MODEL=replace-with-a-pinned-model
OPENAI_API_KEY=
# Optional: your organization's OpenAI-compatible API root, for example https://llm.example.com/v1
OPENAI_BASE_URL=
